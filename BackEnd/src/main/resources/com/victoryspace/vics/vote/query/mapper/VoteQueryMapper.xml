    <select id="findByMemberId" resultMap="VoteListResponse">
        SELECT
            v.id,
            v.title,
            c.name as category_name,
            m.nickname as member_nickname,
            v.created_at,
            v.updated_at,
            v.duration,
            v.ended_at
        FROM vote v
        JOIN category c ON c.id = v.category_id
        JOIN member m ON m.id = v.member_id
        WHERE v.member_id = #{memberId}
        AND v.deleted_at IS NULL
        ORDER BY v.created_at DESC
    </select>

    <select id="findByChallengerId" resultMap="VoteListResponse">
        SELECT
            v.id,
            v.title,
            c.name as category_name,
            m.nickname as member_nickname,
            v.created_at,
            v.updated_at,
            v.duration,
            v.ended_at
        FROM vote v
        JOIN category c ON c.id = v.category_id
        JOIN member m ON m.id = v.member_id
        WHERE v.challenger_id = #{challengerId}
          AND v.deleted_at IS NULL
        ORDER BY v.created_at DESC
    </select>

    <select id="search" resultMap="VoteListResponse">
        SELECT
            v.id,
            v.title,
            c.name AS category_name,
            m.nickname AS member_nickname,
            v.created_at,
            v.updated_at,
            v.duration,
            v.ended_at
        FROM vote v
        JOIN category c ON c.id = v.category_id
        JOIN member m ON m.id = v.member_id
        <where>
            v.deleted_at IS NULL

            <if test="title != null and title != ''">
                AND v.title LIKE CONCAT('%', #{title}, '%')
            </if>

            <if test="categoryId != null">
                AND v.category_id = #{categoryId}
            </if>

            <if test="nickname != null and nickname != ''">
                AND m.nickname LIKE CONCAT('%', #{nickname}, '%')
            </if>

            <if test="content != null and content != ''">
                AND v.content LIKE CONCAT('%', #{content}, '%')
            </if>
        </where>
        ORDER BY v.created_at DESC
    </select>
</mapper>