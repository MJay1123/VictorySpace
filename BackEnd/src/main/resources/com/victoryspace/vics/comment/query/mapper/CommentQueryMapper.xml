<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.victoryspace.vics.comment.query.mapper.CommentQueryMapper">
    <resultMap id="CommentResultMap"
               type="com.victoryspace.vics.comment.query.dto.CommentQueryDTO">
        <id property="id" column="id"/>
        <result property="voteId" column="vote_id"/>
        <result property="memberId" column="member_id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <resultMap id="VoteCommentDTO"
               type="com.victoryspace.vics.comment.query.dto.response.VoteCommentDTO">
        <id property="id" column="id"/>
        <result property="memberNickname" column="member_nickname"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="canEdit" column="can_edit"/>
    </resultMap>

    <resultMap id="VoteCommentResponse"
               type="com.victoryspace.vics.comment.query.dto.response.VoteCommentResponseDTO">
        <id property="id" column="id"/>
        <result property="memberNickname" column="member_nickname"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="canEdit" column="can_edit"/>
    </resultMap>

    <select id="findAll" resultMap="CommentResultMap">
        SELECT id,
               vote_id,
               member_id,
               content,
               created_at,
               updated_at,
               deleted_at
        FROM comment
    </select>

    <select id="findById" resultMap="CommentResultMap">
        SELECT id,
               vote_id,
               member_id,
               content,
               created_at,
               updated_at,
               deleted_at
        FROM comment
        WHERE id = #{id}
    </select>

    <select id="findByVoteId" resultMap="VoteCommentDTO">
        SELECT c.id,
               c.member_id,
               m.nickname as member_nickname,
               c.content,
               c.created_at,
               c.updated_at
        FROM comment c
        JOIN member m ON m.id = c.member_id
        WHERE c.vote_id = #{voteId}
        AND c.deleted_at IS NULL
    </select>

    <select id="findByMemberId" resultMap="CommentResultMap">
        SELECT id,
               vote_id,
               member_id,
               content,
               created_at,
               updated_at,
               deleted_at
        FROM comment
        WHERE member_id = #{memberId}
    </select>
</mapper>